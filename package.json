{
  "name": "aitrade",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.6.0"
  },
  "scripts": {
    "dev": "next dev -p 1688",
    "build": "next build",
    "start": "next start -p 1688",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint",
    "theme:check": "node scripts/check-theme-colors.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:e2e": "playwright test",
    "report:dry-run": "node --experimental-strip-types scripts/report-dry-run.ts",
    "screenshots": "bash scripts/capture-screenshots.sh",
    "db:reset": "node -e \"import('node:fs').then(fs => { fs.rmSync('.data/aitrade', { recursive: true, force: true }); fs.rmSync('.data/competitor-comparisons.json', { force: true }); fs.rmSync('.data/aitrade-assets', { recursive: true, force: true }); })\""
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.5.15",
    "iconv-lite": "^0.6.3",
    "next": "^16.4.5",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "oxlint": "^1.95.0",
    "typescript": "^7.0.2"
  }
}
