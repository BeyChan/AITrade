{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "react", "nextjs"],
  "ignorePatterns": [
    ".next/**",
    ".data/**",
    "out/**",
    "build/**",
    "graphify-out/**",
    "extensions/**",
    "test-results/**",
    ".codex-artifacts/**",
    "next-env.d.ts"
  ],
  "rules": {
    "nextjs/no-img-element": "off",
    "react/react-in-jsx-scope": "off",
    "no-unused-vars": "warn",
    "typescript/no-explicit-any": "warn"
  }
}
