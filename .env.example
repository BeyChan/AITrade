# Local embedded PostgreSQL data directory.
PGLITE_DATA_DIR=.data/aitrade

# Default workflow uses CSV/manual data and requires no paid API key.
# Optional official seller authorization is only for your own store data.
# Read-only seller connection diagnostics. Leave blank until official authorization is complete.
# Amazon: na | eu | fe
AMAZON_SP_API_REGION=na
AMAZON_SP_API_CLIENT_ID=
AMAZON_SP_API_CLIENT_SECRET=
AMAZON_SP_API_REFRESH_TOKEN=

# Shopify: domain must be <shop>.myshopify.com; API version uses YYYY-MM.
SHOPIFY_SHOP_DOMAIN=
SHOPIFY_ACCESS_TOKEN=
SHOPIFY_API_VERSION=2026-10

# eBay: production by default; sandbox is for testing only.
EBAY_ENVIRONMENT=production
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=

# Registered but unsupported: diagnostics do not make external requests.
TIKTOK_SHOP_APP_KEY=
TIKTOK_SHOP_APP_SECRET=
ALIBABA_1688_APP_KEY=
ALIBABA_1688_APP_SECRET=

# AI sourcing hypothesis generation. Template mode needs no API key.
AI_PROVIDER=template
AI_BASE_URL=
AI_MODEL=
AI_API_KEY=

# Optional: pin the local encryption key for page-saved AI credentials.
# If omitted, AITrade generates .data/aitrade.ai-key with mode 0600.
AI_SETTINGS_ENCRYPTION_KEY=
